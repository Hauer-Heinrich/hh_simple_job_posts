{
    "type": "typo3-cms-extension",
    "name": "hauerheinrich/hh-simple-job-posts",
    "description": "Adds plugins for list / show job postings with meta-data and schema.org stuff. Uses tt_address for job-contacts and job-location.",
    "keywords": ["TYPO3 CMS", "jobs", "Extension"],
    "homepage": "https://www.hauer-heinrich.de",
    "license": ["GPL-2.0-or-later"],
    "authors": [
        {
            "name": "Christian Hackl",
            "homepage": "http://www.hauer-heinrich.de",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/Hauer-Heinrich/hh_simple_job_posts/issues",
        "source": "https://github.com/Hauer-Heinrich/hh_simple_job_posts",
        "docs": "https://github.com/Hauer-Heinrich/hh_simple_job_posts/blob/master/README.md"
    },
    "funding": [
        {
            "type": "paypal",
            "url": "https://www.paypal.com/paypalme/hauerheinrich"
        }
    ],
    "require": {
        "typo3/cms-core": "^13.4.0 || ^14.3.0",
        "typo3/cms-extbase": "^13.4.0 || ^14.3.0",
        "typo3/cms-fluid": "^13.4.0 || ^14.3.0",
        "typo3/cms-frontend": "^13.4.0 || ^14.3.0",
        "typo3/cms-fluid-styled-content": "^13.4.0 || ^14.3.0",
        "friendsoftypo3/tt-address": "^10.0.0",
        "hauerheinrich/hh-tt-address-places": "^5.0.0"
    },
    "autoload": {
        "psr-4": {
            "HauerHeinrich\\HhSimpleJobPosts\\": "Classes"
        }
    },
    "extra": {
        "typo3/cms": {
            "cms-package-dir": "{$vendor-dir}/typo3/cms",
            "web-dir": ".Build/Web",
            "extension-key": "hh_simple_job_posts",
            "version": "6.1.0",
            "Package": {
                "providesPackages": {}
            }
        }
    },
    "archive": {
        "exclude": [
            "/.git/",
            "/.github/",
            "/.idea/",
            "/.editorconfig",
            "/.gitattributes",
            "/.gitignore",
            "/.bundle.config.json",
            "/.bundle.config.json.example",
            "/.bundle.mjs",
            "/package.json",
            "/package-lock.json",
            "/*.code-workspace",
            "**/node_modules/",
            "**/*.zip"
        ]
    }
}
